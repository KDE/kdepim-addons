#: updateincidencetool/updateincidencetooljob.cpp:120
#, kde-format
msgid "Argument end is only valid for events"
msgstr "არგუმენტი end, მხოლოდ, მოვლენებისთვისაა სწორი"

#: updateincidencetool/updateincidencetooljob.cpp:123
#, kde-format
msgid "Arguments due, priority and completed are only valid for to-dos"
msgstr ""
"არგუმენტების დრო, პრიორიტეტი და დასრულებულობა, მხოლოდ, გასაკეთებლებისთვისაა"

#: updateincidencetool/updateincidencetooljob.cpp:159
#, kde-format
msgid "Argument end must be a date for an all-day event"
msgstr "არგუმენტი end მთელდღიანი მოვლენისთვის თარიღი უნდა იყოს"

#: updateincidencetool/updateincidencetooljob.cpp:159
#, kde-format
msgid "Argument end must be a date-time for a timed event"
msgstr "არგუმენტი end ზუსტი დროის თარიღისთვის თარიღი-დრო ფორმატში უნდა იყოს"

#: updateincidencetool/updateincidencetooljob.cpp:201
#, kde-format
msgid "Start and due dates of a to-do must both be dates or both be date-times"
msgstr ""
"გასაკეთებლის start და due თარიღები, ორივე, ან თარიღი უნდა იყოს, ან თარიღი-დრო"

#: updateincidencetool/updateincidencetooljob.cpp:204
#, kde-format
msgid "Due date must not be before start"
msgstr "მოხდენის თარიღი დასაწყისამდე არ უნდა იყოს"
