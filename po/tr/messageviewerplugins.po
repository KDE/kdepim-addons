msgctxt "@label:textbox"
msgid "<qt><a href=\"whatsthis1\">Argument format information…</a></qt>"
msgstr "<qt><a href=\"whatsthis1\">Argüman biçim bilgisi…</a></qt>"

#: externalscriptplugin/configuredialog/viewerpluginexternaleditwidget.cpp:48
#, kde-format
msgid ""
"<qt><p><strong>These expressions may be used for the arguments:</strong></"
"p><ul><li>%s - the subject of message</li><li>%from - the from email "
"address</li><li>%cc - the list of cc email address</li><li>%bcc - the list "
"of bcc email address</li><li>%body - the body of message</li><li>%inreplyto "
"- the reply email address</li><li>%akonadiUrl - the akonadi url (as akonadi:?"
"item=187020)</li></ul></strong></p></qt>"
msgstr ""
"<qt><p><strong>Bu ifadeler şu argümanlar için kullanılabilir:</strong></"
"p><ul><li>%s — ileti konusu</li><li>%from — e-posta gelen adresi</li><li>%cc "
"- kopyalanacak e-posta adresleri</li><li>%bcc — gizli kopya e-posta "
"adresleri</li><li>%body — ileti gövdesi</li><li>%inreplyto — yanıt e-posta "
"adresi</li><li>%akonadiUrl — Akonadi URL’si (akonadi:?item=187020 "
"biçiminde)</li></ul></strong></p></qt>"

