#: text_calendar.cpp:365
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "Davette “%1” adlı bir ek bulunamadı."

#: text_calendar.cpp:380
#, kde-format
msgid ""
"The invitation attachment \"%1\" is a web link that is inaccessible from "
"this computer. Please ask the event organizer to resend the invitation with "
"this attachment stored inline instead of a link."
msgstr ""
"“%1” daveti eki, bu bilgisayardan erişilemeyen bir web bağlantısıdır. Lütfen "
"organizatörden bu eki bir bağlantı yerine kaydedilmiş şekilde yeniden "
"göndermesini isteyin."

#: text_calendar.cpp:432
#, kde-format
msgid ""
"<qt>None of your identities match the receiver of this message,<br/>please "
"choose which of the following addresses is yours,<br/> if any, or select one "
"of your identities to use in the reply:</qt>"
msgstr ""
"<qt>Kimliklerinizden hiçbiri bu iletinin alıcısı olarak görülmüyor,<br/"
">lütfen aşağıdaki adreslerden uyan varsa hangisinin siz <br/>olduğunu seçin "
"veya yanıtta kullanılacak kimliklerinizden birini seçin:</qt>"

#: text_calendar.cpp:438
#, kde-format
msgid ""
"<qt>Several of your identities match the receiver of this message,<br/"
">please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>Kimliklerinizden birkaçı bu iletinin alıcısı olarak eşleşti,<br/>lütfen "
"aşağıdaki adreslerden hangisinin siz olduğunu seçin:</qt>"

