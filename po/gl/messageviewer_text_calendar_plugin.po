#: text_calendar.cpp:374
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "Non se atopou ningún anexo chamado «%1» na invitación."

#: text_calendar.cpp:389
#, kde-format
msgid ""
"The invitation attachment \"%1\" is a web link that is inaccessible from "
"this computer. Please ask the event organizer to resend the invitation with "
"this attachment stored inline instead of a link."
msgstr ""
"O anexo da invitación, «%1», é unha ligazón web que non é accesíbel desde "
"este computador. Pídalle á organizadora do evento que envíe de novo a "
"invitación co anexo almacenado dentro no canto dunha ligazón."

#: text_calendar.cpp:441
#, kde-format
msgid ""
"<qt>None of your identities match the receiver of this message,<br/>please "
"choose which of the following addresses is yours,<br/> if any, or select one "
"of your identities to use in the reply:</qt>"
msgstr ""
"<qt>Ningunha das súas identidades coincide co destinatario desta mensaxe."
"<br />Escolla cal dos enderezos seguintes é o seu,<br/> de o ser algún, ou "
"escolla unha das súas identidades para usala na resposta.</qt>"

#: text_calendar.cpp:447
#, kde-format
msgid ""
"<qt>Several of your identities match the receiver of this message,<br/"
">please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>Varias das súas identidades coinciden co destinatario desta mensaxe.<br /"
">Escolla cal dos enderezos seguintes é o seu:</qt>"

