#: externalcomposer/externalcomposerconfiguredialog.cpp:16
#, kde-format
msgctxt "@title:window"
msgid "Configure \"External Composer\" Plugin"
msgstr "Configurar el complemento «Editor externo»"

#: externalcomposer/externalcomposerconfigurewidget.cpp:25
#, kde-format
msgctxt "@option:check"
msgid "Use external editor instead of composer"
msgstr "Usar un editor externo en lugar del compositor"

#: externalcomposer/externalcomposerconfigurewidget.cpp:37
#, kde-format
msgid "Specify editor:"
msgstr "Especificar editor:"

#: externalcomposer/externalcomposerconfigurewidget.cpp:53
#, kde-format
msgctxt "@label:textbox"
msgid ""
"<b>%f</b> will be replaced with the filename to edit.<br /><b>%w</b> will be "
"replaced with the window id.<br /><b>%l</b> will be replaced with the line "
"number."
msgstr ""
"<b>%f</b> se sustituirá con el nombre de archivo a editar.<br /><b>%w</b> se "
"sustituirá con el id. de ventana<br /><b>%l</b> se sustituirá con el número "
"de línea."
