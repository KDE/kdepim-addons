#: text_calendar.cpp:375
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "Gonbidapenean ez da \"%1\" izeneko eranskinik aurkitu."

#: text_calendar.cpp:390
#, kde-format
msgid ""
"The invitation attachment \"%1\" is a web link that is inaccessible from "
"this computer. Please ask the event organizer to resend the invitation with "
"this attachment stored inline instead of a link."
msgstr ""
"\"%1\" gonbidapen eranskina ordenagailu honetatik atzi daitekeen web esteka "
"bat da. Mesedez, eskatu ekitaldiaren antolatzaileari gonbidapena berriz "
"bidaltzeko, esteka baten ordez, eranskina lerro barruan duela."

#: text_calendar.cpp:442
#, kde-format
msgid ""
"<qt>None of your identities match the receiver of this message,<br/>please "
"choose which of the following addresses is yours,<br/> if any, or select one "
"of your identities to use in the reply:</qt>"
msgstr ""
"<qt>Ez dago mezu horretako hartzailearekin bat datorren nortasunik,<br/"
">mesedez, egongo balitz, aukeratu ondoko helbideetatik zurea zein den,<br/"
">edo hautatu, erantzunean erabiltzeko, zure nortasunetako bat:</qt>"

#: text_calendar.cpp:448
#, kde-format
msgid ""
"<qt>Several of your identities match the receiver of this message,<br/"
">please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>Zure nortasunetako batzuk mezu horren hartzailearekin bat datoz,<br/"
">mesedez, hautatu ondoko helbideetako zein den zurea:</qt>"

